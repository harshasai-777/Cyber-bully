!models/README.md
*.safetensors
*.bin
*.pt
*.pth
checkpoints/

# Datasets and Cache Folders
.cache/
data/cache/
data/downloads/

# Evaluation output images and reports (can be generated locally)
# Keep .gitkeep in results
results/*
!results/.gitkeep

# IDEs & System
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
